NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false

RATE_GLOBAL_TTL=900
RATE_GLOBAL_LIMIT=100
RATE_LOGIN_TTL=600
RATE_LOGIN_LIMIT=10

ENABLE_SWAGGER=true
REQUEST_ID_HEADER=x-request-id
